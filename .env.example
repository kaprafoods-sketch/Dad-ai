# ── Database (Supabase Postgres) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Supabase ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET= # API verifies access tokens with this (Project Settings → API → JWT Secret)

# ── Local dev auth (NEVER set in staging/prod) ──
# DEV_AUTH_BYPASS=1  # trust x-tenant-id / x-user-id / x-role / x-plan headers instead of a JWT

# ── Redis (Upstash) ──
REDIS_URL=

# ── LLMs ──
OPENROUTER_API_KEY=
EMBEDDINGS_API_KEY=          # optional; falls back to OPENAI_API_KEY
EMBEDDINGS_BASE_URL=         # optional; defaults to https://api.openai.com/v1

# ── Security ──
CREDENTIALS_ENCRYPTION_KEY=  # 32-byte hex (openssl rand -hex 32) for AES-256-GCM connector tokens
ADMIN_API_KEY=               # guards admin endpoints + tenant provisioning (x-admin-key header)

# ── API / CORS ──
PORT=4000
CORS_ORIGINS=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:3000

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_VERIFY_TOKEN=       # your chosen webhook verification token
WHATSAPP_APP_SECRET=         # Meta app secret (verifies inbound webhook signatures)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_TOKEN=

# ── Google (Calendar/Gmail/Drive) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/connectors/google/callback

# ── Email / SMS ──
RESEND_API_KEY=
RESEND_FROM=noreply@nirmaanco.in  # PLANNED domain — confirm before production use
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Billing (Razorpay) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # verifies /v1/billing/webhooks/razorpay signatures

# ── Workflow engine (n8n) ──
N8N_BASE_URL=
N8N_API_KEY=

# ── Seed (tenant #0, the agency) ──
AGENCY_SLUG=dad-ai
AGENCY_OWNER_EMAIL=owner@dad-ai.local
